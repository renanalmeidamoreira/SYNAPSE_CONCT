rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email != null && (
          request.auth.token.email.matches('(?i)^r\\.fabulous\\.30@gmail\\.com$') ||
          request.auth.token.email == 'R.Fabulous.30@gmail.com' ||
          request.auth.token.email == 'r.fabulous.30@gmail.com'
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId || isSuperAdmin()
      );
    }

    // Authorized Users Whitelist Collection
    match /authorizedUsers/{userEmail} {
      // Authenticated users can check if their email or any email is authorized
      allow read: if isAuthenticated();
      // Super admin can add, update, or revoke access
      allow create, update, delete: if isSuperAdmin();
    }

    // User Profiles and nested user collections
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isSuperAdmin();

      // Nested courses
      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // Nested metadata
      match /meta/{metaId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
